# ==============================================================================
# Educaro Applicant Journey - Environment Configuration
# ImpactX'26 Hackathon (Agentic AI Track)
# ==============================================================================

# API Backend Configuration
NODE_ENV=development
PORT=3001

# PostgreSQL Database (Docker Compose default)
POSTGRES_USER=educaro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=educaro_db
DATABASE_URL=postgresql://educaro:change-me@localhost:5432/educaro_db?schema=public

# Redis Cache & Background Jobs
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO Object Storage (S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=educaro-documents
S3_USE_SSL=false

# Direct UPI / QR Payment Configuration (PRD Section 8.3 - Unified Educaro Premium)
# Direct UPI collection without gateway or webhooks
PAYMENT_UPI_ID=your-upi-id@example
PAYMENT_PLAN_AMOUNT=100
PAYMENT_PLAN_NAME=Educaro Premium
EDUCARO_PAYEE_NAME=Educaro Deutschland GmbH
DEMO_MODE=true

# SendGrid OTP and notification email delivery
# Verify this sender address (or its domain) in SendGrid Sender Authentication.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# AI / Agent Configuration
# LLM provider for chat intake, structured extraction, video analysis
GROQ_API_KEY=


# Frontend Configuration
VITE_API_URL=http://localhost:3001

CONSULTANT_PHONE_NUMBER=+10000000000
