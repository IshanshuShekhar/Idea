# ==============================================================================
# Educaro Applicant Journey - Environment Configuration
# ==============================================================================

# Backend API Port
PORT=3001

# JWT Secret for Session & Tokens
JWT_SECRET=educaro-hackathon-impactx26-super-secret-key-jwt

# Database Configuration
# If DATABASE_URL is unreachable or omitted, the API automatically falls back
# to an embedded in-memory PostgreSQL engine (pg-mem) with zero external setup.
DATABASE_URL=postgresql://educaro:educaropassword@localhost:5432/educaro_db?schema=public

# ------------------------------------------------------------------------------
# LLM Provider Configuration (OpenAI-compatible)
# All LLM calls (chatJson, describeImage) route strictly through LlmService.
# On repeated offline failure, the system falls back gracefully to grounded seeded data.
# ------------------------------------------------------------------------------

# Option 1: Local Ollama (Default)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_VISION_MODEL=qwen2.5vl

# Option 2: xAI Grok
# Uncomment below to use xAI Grok as your LLM provider:
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=xai-your-api-key-here
# LLM_MODEL=grok-2-latest
# LLM_VISION_MODEL=grok-2-vision-latest

# ------------------------------------------------------------------------------
# Optional Local Speech-to-Text (STT) for Spoken Video Intros
# Note: Spoken intro transcript paste is the primary path.
# Set WHISPER_CMD only if you have local Whisper CLI installed:
# WHISPER_CMD=whisper
# ------------------------------------------------------------------------------
